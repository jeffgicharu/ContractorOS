# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contractor_os
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/contractor_os_test

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Postgres connection pool tuning. Defaults (40 / 30s / 5s) are sized for
# the VPS box and match what the spike-load tests showed we need.
# Bump PG_POOL_MAX if you observe `connection acquisition timeout`s
# under higher concurrency.
PG_POOL_MAX=40
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000

# Rate limiter (nestjs/throttler). Defaults: 60 requests per 60 s per IP.
# Set THROTTLE_LIMIT=0 to disable entirely for unconstrained load tests.
THROTTLE_TTL=60
THROTTLE_LIMIT=60
