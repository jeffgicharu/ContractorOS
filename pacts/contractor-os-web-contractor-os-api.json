    {
      "description": "a contractor creating an invoice with one line item",
      "providerStates": [
        {
          "name": "an active engagement 00000000-0000-0000-0000-0000000000e1 exists for the contractor in org A"
        }
      ],
      "request": {
        "body": {
          "engagementId": "00000000-0000-0000-0000-0000000000e1",
          "invoiceNumber": "PACT-INV-001",
          "lineItems": [
            {
              "description": "Hours",
              "quantity": 8,
              "unitPrice": 125
            }
          ],
          "periodEnd": "2026-04-30",
          "periodStart": "2026-04-01"
        },
        "headers": {
          "Authorization": "Bearer pact-contractor-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/invoices"
      },
      "response": {
        "body": {
          "data": {
            "id": "33333333-3333-3333-3333-333333333333",
            "invoiceNumber": "PACT-INV-001",
            "status": "draft"
          }
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
